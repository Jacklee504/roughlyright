{
  "name": "roughly-right",
  "version": "0.1.0",
  "private": true,
  "description": "Roughly Right — daily estimation web game (Estimation prototype, shared site per handoff contract)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "verify": "NEXT_DIST_DIR=.next-verify next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && tsx tests/integration.mts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "content:publish": "tsx scripts/publish-content.mts",
    "jobs:daily": "tsx scripts/jobs-daily.mts",
    "db:reset": "rm -rf .data && npm run db:migrate && npm run db:seed",
    "import": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "next": "^15.5.6",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
